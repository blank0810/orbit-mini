# Production environment for the tunnelled deployment at https://orbit.ehnand.com
#
# NEVER COMMITTED. Covered by .gitignore's .env.* rule.
# Secrets here are freshly generated and deliberately different from .env:
# a development password that reaches production is a development password no longer.
#
# Run with:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up -d --build

# --- Database -------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=
POSTGRES_DB=orbit
DATABASE_URL=postgresql+psycopg://orbit:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/orbit

# --- Application ----------------------------------------------------------
# production (not development) is what turns the Secure flag on for the session
# cookie. Over the tunnel every request is HTTPS, so there is no reason to ship
# a cookie that would also travel over plaintext.
ENVIRONMENT=production

# The tunnel serves web and API from one origin and routes /api/* to the API
# container, so the browser's requests are same-origin and this is the only
# host CORS ever needs to allow.
CORS_ORIGINS=https://orbit.ehnand.com
WEB_BASE_URL=https://orbit.ehnand.com
NEXT_PUBLIC_API_BASE_URL=https://orbit.ehnand.com

# Distinct from the development secret. Reusing one would mean a session cookie
# minted on a laptop is valid against the public deployment.
JWT_SECRET=

# --- Stripe ---------------------------------------------------------------
# FILL THESE IN. The API answers 503 on checkout until the key is present.
STRIPE_SECRET_KEY=
# From the sandbox webhook endpoint pointed at
# https://orbit.ehnand.com/api/webhooks/stripe - not from the CLI listener.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID_STARTER=prod_VIiY4x4UPOjJkc
STRIPE_PRODUCT_ID_PRO=prod_VIiYndmcFisPhz

# --- pgAdmin --------------------------------------------------------------
# Still bound to 127.0.0.1 only, and the tunnel's ingress rules never route to
# it, so it is not reachable from the internet. The password is rotated anyway.
PGADMIN_DEFAULT_EMAIL=admin@ehnand.com
PGADMIN_DEFAULT_PASSWORD=
