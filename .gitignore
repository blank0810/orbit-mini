# Secrets, never commit
.env
.env.*
!.env.example
!.env.prod.example
infra/cloudflared/*.json
infra/cloudflared/cert.pem

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Flutter / Dart
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins*
mobile/.packages

# Media artifacts
media/input/
media/output/
*.mp4
*.mov
!docs/**/*.mp4
# The walkthrough is served by the app itself, so it has to survive a clean clone:
# `COPY . .` in web/Dockerfile builds from the checkout, not from this machine.
!web/public/*.mp4

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

