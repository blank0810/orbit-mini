# Host ports 7301 (web), 7302 (API), and 7303 (PostgreSQL) were chosen
# because 3000, 8000, and 5432 collide with other projects on this machine.
# All published ports bind to 127.0.0.1 only.
POSTGRES_USER=orbit
# Fill in POSTGRES_PASSWORD in your local .env before starting the stack.
POSTGRES_PASSWORD=
POSTGRES_DB=orbit

# Complete connection string. `db` is the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://orbit:@db:5432/orbit
CORS_ORIGINS=http://localhost:7301
ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:7302

# pgAdmin is a local development tool; set its startup password in .env.
PGADMIN_DEFAULT_EMAIL=admin@orbit.local
PGADMIN_DEFAULT_PASSWORD=

# Stripe, test mode. The product and price are created BY HAND in the Stripe
# dashboard - this application never creates catalogue objects.
# STRIPE_PRICE_ID must be a RECURRING price in GBP, or Checkout rejects it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Session signing. Generate with: openssl rand -hex 32
JWT_SECRET=
